diff --git a/src/sdk/SceneViewStereoLayout.hpp b/src/sdk/SceneViewStereoLayout.hpp
new file mode 100644
index 0000000..73a010b
--- /dev/null
+++ b/src/sdk/SceneViewStereoLayout.hpp
@@ -0,0 +1,15 @@
+#pragma once
+
+#include <cstdint>
+#include <string_view>
+
+namespace sdk {
+// UE5.6/5.7 inserted exposure-state and view-owner fields before the colors.
+// The old +0x58 stereo-pass offset now addresses ColorScale.R.
+constexpr uint32_t scene_view_stereo_pass_delta(
+    std::wstring_view engine_version, uint32_t file_major, uint32_t file_minor) {
+    const bool modern = engine_version == L"5.6" || engine_version == L"5.7" ||
+        (engine_version.empty() && file_major == 5 && (file_minor == 6 || file_minor == 7));
+    return modern ? 0x68U : 0x58U;
+}
+}
