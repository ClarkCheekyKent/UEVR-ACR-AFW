diff --git a/tests/ColorScaleLayoutTest.cpp b/tests/ColorScaleLayoutTest.cpp
new file mode 100644
index 0000000..368ad6f
--- /dev/null
+++ b/tests/ColorScaleLayoutTest.cpp
@@ -0,0 +1,52 @@
+#include "../src/sdk/SceneViewStereoLayout.hpp"
+#include <array>
+#include <cstddef>
+#include <cstdio>
+#include <cstring>
+
+// Layout from Joey's UE5.6/5.7 SDK, starting at the discovered Family field.
+struct UE56Tail {
+    void* family{};
+    void* scene_state{};
+    void* exposure_state{};
+    uint32_t actor_id{};
+    uint32_t actor_pad{};
+    void* actor{};
+    int32_t player_index{};
+    void* drawer{};
+    float background[4]{};
+    float overlay[4]{};
+    float color_scale[4]{1.0f, 0.8f, 0.6f, 1.0f};
+    uint32_t stereo_pass{2};
+};
+static_assert(offsetof(UE56Tail, color_scale) == 0x58);
+static_assert(offsetof(UE56Tail, stereo_pass) == 0x68);
+static_assert(sdk::scene_view_stereo_pass_delta(L"5.6", 0, 0) == 0x68);
+static_assert(sdk::scene_view_stereo_pass_delta(L"5.7", 0, 0) == 0x68);
+static_assert(sdk::scene_view_stereo_pass_delta(L"", 5, 6) == 0x68);
+static_assert(sdk::scene_view_stereo_pass_delta(L"", 5, 7) == 0x68);
+static_assert(sdk::scene_view_stereo_pass_delta(L"5.5", 5, 6) == 0x58);
+static_assert(sdk::scene_view_stereo_pass_delta(L"4.27", 0, 0) == 0x58);
+static_assert(sdk::scene_view_stereo_pass_delta(L"5.8", 0, 0) == 0x58);
+static_assert(sdk::scene_view_stereo_pass_delta(L"5.60", 0, 0) == 0x58);
+static_assert(sdk::scene_view_stereo_pass_delta(L"", 0, 0) == 0x58);
+
+int main() {
+    UE56Tail options{};
+    std::array<unsigned char, sizeof(options)> before{};
+    std::memcpy(before.data(), &options, sizeof(options));
+    const uint32_t primary = 1;
+    const auto offset = sdk::scene_view_stereo_pass_delta(L"5.6", 0, 0);
+    std::memcpy(reinterpret_cast<unsigned char*>(&options) + offset, &primary, sizeof(primary));
+    if (options.stereo_pass != primary ||
+        std::memcmp(before.data(), &options, offsetof(UE56Tail, stereo_pass)) != 0) {
+        return 1;
+    }
+    // Reproduce the old bug: writing the stereo flag changes the red multiplier.
+    UE56Tail old_options{};
+    std::memcpy(reinterpret_cast<unsigned char*>(&old_options) + 0x58, &primary, sizeof(primary));
+    if (old_options.color_scale[0] == 1.0f || old_options.stereo_pass != 2) {
+        return 2;
+    }
+    std::puts("PASS: version gates, old color corruption reproduced, corrected write preserves all color fields.");
+}
